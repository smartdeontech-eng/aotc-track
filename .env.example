# ============ AOTC Track ============
# --- Core ---
PORT=3000
JWT_SECRET=replace-this-with-a-long-random-string

# --- Email notifications (password reset / recovery / reminders) ---
# Leave SMTP_HOST blank to disable all emails (the app still works, but
# "Forgot password" and email reminders cannot send anything).
# Using Gmail? You need a 16-character "App Password":
#   1. Turn on 2-Step Verification (myaccount.google.com/security)
#   2. Create an app password at myaccount.google.com/apppasswords
#   3. Use it as SMTP_PASS (SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AOTC Track <admin@pcg-aotc.com>

# --- SMS notifications — via mNotify (mnotify.com), Ghana SMS gateway ---
# Leave SMS_API_KEY blank to disable SMS (the app still works, it just won't text).
#   1. Log in at mnotify.com > Account > API Keys, copy your API key.
#   2. Sender ID "PCG-AOTC" must be registered/approved with mNotify first.
#   3. Only +233 (Ghana) numbers are texted; other countries are skipped.
SMS_API_KEY=
SMS_SENDER_ID=PCG-AOTC

# Where system/recovery notices are sent (Session Clerk / admin inbox)
NOTIFY_EMAIL=gadjei@pcg-aotc.com

# Base URL of the app (used in emailed links), e.g. https://track.pcg-aotc.com
APP_URL=

# --- Timezone ---
# The congregation keeps Ghana time (UTC+0, no DST). On the VPS this is set by
# deploy/aotc-track.service; set it here when running on a laptop that is in
# another zone, or the server's idea of "today" (reminder windows, quarter
# boundaries, default dates) will be a day out from the Clerk's.
TZ=Africa/Accra

# --- Passkeys (WebAuthn) — production only, requires HTTPS ---
# WEBAUTHN_RP_ID=track.pcg-aotc.com
# WEBAUTHN_ORIGIN=https://track.pcg-aotc.com

# --- Correspondence auto-summary (Session Minutes) ---
# Lets the Minutes page read a photograph of a letter and draft the heading,
# summary and suggested action in the minutes' house style. Leave blank to
# switch the feature off — the clerk then types the heading and summary, and
# nothing else in the app is affected. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: override the model used for that drafting.
# ANTHROPIC_MODEL=claude-opus-5-5
